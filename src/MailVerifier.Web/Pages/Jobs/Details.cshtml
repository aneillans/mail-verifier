@page "{id:int}"
@model MailVerifier.Web.Pages.Jobs.JobDetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Job #{Model.Job?.Id} Details";
    var isLive = JobStatus.IsActive(Model.Job?.Status);
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Model.Job == null)
    {
        <div class="alert alert-warning">Job not found.</div>
        <a asp-page="/Jobs/Index" class="btn btn-secondary">Back to Jobs</a>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Job #@Model.Job.Id Results</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Job.Name))
                {
                    <p class="text-muted mb-0">@Model.Job.Name</p>
                }
            </div>
            <a asp-page="/Jobs/Index" class="btn btn-outline-secondary">← Back to Jobs</a>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Status</h5>
                        @{
                            var badgeClass = Model.Job.Status switch
                            {
                                JobStatus.Completed => "bg-success",
                                JobStatus.Processing => "bg-warning text-dark",
                                "Pending"    => "bg-secondary",
                                "Failed"     => "bg-danger",
                                "Stopped"    => "bg-secondary",
                                _            => "bg-secondary"
                            };
                        }
                        <span id="status-badge" class="badge @badgeClass fs-6">@Model.Job.Status</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Total</h5>
                        <p class="display-6">@Model.Job.TotalEmails</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Valid Mailboxes</h5>
                        <p id="valid-count" class="display-6 text-success">@Model.Results.Count(r => r.Result.MailboxExists)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">Created</h5>
                        <p>@Model.Job.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>

        @if (isLive)
        {
            <div class="mb-4">
                <div class="d-flex justify-content-between mb-1">
                    <span class="small text-muted">Processing&hellip;</span>
                    <span id="progress-label" class="small text-muted">
                        @Model.Job.ProcessedEmails / @Model.Job.TotalEmails
                    </span>
                </div>
                <div class="progress" style="height:20px">
                    <div id="progress-bar"
                         class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                         role="progressbar"
                         style="width:@(Model.Job.TotalEmails > 0 ? (Model.Job.ProcessedEmails * 100 / Model.Job.TotalEmails) : 0)%">
                    </div>
                </div>
                <div class="mt-2 d-flex justify-content-between">
                    <span class="small">Estimated time remaining:</span>
                    <span id="eta-display" class="small fw-bold">@Model.EstimatedTimeRemaining</span>
                </div>
            </div>
        }

        <div class="mb-4">
            @{
                var timedOutCount = Model.Results.Count(r => !string.IsNullOrEmpty(r.Result.ErrorMessage));
            }
            @if (Model.Job.Status == JobStatus.Completed)
            {
                <form method="post" class="d-inline-flex align-items-center gap-2">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="excludeAtRisk" value="true" id="excludeAtRisk" />
                        <label class="form-check-label small" for="excludeAtRisk">Exclude "At risk" mailboxes</label>
                    </div>
                    <button type="submit" asp-page-handler="DownloadCsv" asp-route-id="@Model.Job.Id"
                            class="btn btn-outline-success">
                        <i class="bi bi-download me-2"></i>Download CSV
                    </button>
                </form>
                <a asp-page="/Jobs/SqlScript" asp-route-id="@Model.Job.Id" class="btn btn-outline-success">
                    <i class="bi bi-code-slash me-2"></i>Generate SQL
                </a>
                @if (timedOutCount > 0)
                {
                    <form method="post" style="display:inline-block;">
                        <button type="submit" asp-page-handler="RerunTimeouts" asp-route-id="@Model.Job.Id"
                                class="btn btn-outline-warning"
                                onclick="return confirm('Rerun @timedOutCount timed-out email(s)?');">
                            <i class="bi bi-arrow-clockwise me-2"></i>Rerun @timedOutCount Timeout(s)
                        </button>
                    </form>
                }
                @if (Model.Results.Count > 0)
                {
                    <form method="post" style="display:inline-block;">
                        <button type="submit" asp-page-handler="DeleteResults" asp-route-id="@Model.Job.Id"
                                class="btn btn-outline-danger"
                                onclick="return confirm('Delete all @Model.Results.Count result(s)? This cannot be undone.');">
                            <i class="bi bi-trash me-2"></i>Delete Results
                        </button>
                    </form>
                }
            }
            @if (isLive)
            {
                <form method="post" style="display:inline-block;">
                    <button type="submit" asp-page-handler="StopJob" asp-route-id="@Model.Job.Id"
                            class="btn btn-outline-danger"
                            onclick="return confirm('Stop this job?');">
                        <i class="bi bi-hand-thumbs-down me-2"></i>Stop Job
                    </button>
                </form>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Email</th>
                        <th>Domain Exists</th>
                        <th>MX Records</th>
                        <th>Mailbox Exists</th>
                        <th>Status</th>
                        <th>At Risk List Signal</th>
                        <th>Error</th>
                        <th>Verified At</th>
                        <th>SMTP Log</th>
                    </tr>
                </thead>
                <tbody id="results-tbody">
                    @foreach (var summary in Model.Results)
                    {
                        var result = summary.Result;
                        <tr data-result-id="@result.Id">
                            <td>@result.EmailAddress</td>
                            <td>
                                @if (result.IsRetested && result.OriginalDomainExists.HasValue)
                                {
                                    <div class="small text-muted">
                                        @if (result.OriginalDomainExists.Value)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        <small>(1st)</small>
                                    </div>
                                }
                                @if (result.DomainExists)
                                {
                                    <span class="badge bg-success">✓ Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">✗ No</span>
                                }
                                @if (result.IsRetested)
                                {
                                    <small class="text-muted">(retest)</small>
                                }
                            </td>
                            <td>
                                @if (result.IsRetested && result.OriginalHasMxRecords.HasValue)
                                {
                                    <div class="small text-muted">
                                        @if (result.OriginalHasMxRecords.Value)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        <small>(1st)</small>
                                    </div>
                                }
                                @if (result.HasMxRecords)
                                {
                                    <span class="badge bg-success">✓ Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">✗ No</span>
                                }
                                @if (result.IsRetested)
                                {
                                    <small class="text-muted">(retest)</small>
                                }
                            </td>
                            <td>
                                @if (result.IsRetested && result.OriginalMailboxExists.HasValue)
                                {
                                    <div class="small text-muted">
                                        @if (result.OriginalMailboxExists.Value)
                                        {
                                            <span class="badge bg-success">✓ Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">✗ No</span>
                                        }
                                        <small>(1st)</small>
                                    </div>
                                }
                                @if (result.MailboxExists)
                                {
                                    <span class="badge bg-success">✓ Yes</span>
                                }
                                else if (result.IsRetryable)
                                {
                                    <span class="badge bg-warning text-dark">? Unknown</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">✗ No</span>
                                }
                                @if (result.IsRetested)
                                {
                                    <small class="text-muted">(retest)</small>
                                }
                            </td>
                            <td>
                                @if (result.IsRetested)
                                {
                                    <span class="badge bg-info">🔄 Retested</span>
                                }
                                else if (result.IsPotentialSoftFailure)
                                {
                                    <span class="badge bg-warning text-dark">⚠ At risk (list match)</span>
                                }
                                else if (result.IsAtRisk)
                                {
                                    <span class="badge bg-warning text-dark">⚠ At risk@(result.IsCatchAll ? " (catch-all)" : "")</span>
                                }
                                else if (result.IsVerified)
                                {
                                    <span class="badge bg-success">✓ Verified</span>
                                }
                                else if (result.IsRetryable)
                                {
                                    <span class="badge bg-warning text-dark">⟳ Retryable</span>
                                }
                                else if (result.IsInvalidMailbox)
                                {
                                    <span class="badge bg-danger">✗ Invalid Mailbox</span>
                                }
                                else if (!string.IsNullOrEmpty(result.ErrorMessage))
                                {
                                    <span class="badge bg-danger">⚠ Failed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">• Unverified</span>
                                }
                            </td>
                            <td>
                                @if (result.IsPotentialSoftFailure)
                                {
                                    <span class="badge bg-warning text-dark">Match</span>
                                    @if (!string.IsNullOrWhiteSpace(result.SoftFailureNote))
                                    {
                                        <div class="small text-muted mt-1">@result.SoftFailureNote</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(result.ErrorMessage))
                                {
                                    <span class="text-danger small">@result.ErrorMessage</span>
                                }
                            </td>
                            <td class="small">@result.VerifiedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td>
                                @if (summary.HasLog)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            data-log-url="/api/jobs/@Model.Job.Id/results/@result.Id/log">
                                        Show Log
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.Job != null)
{
    <script>
    (function () {
        function escHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // SMTP logs are loaded on demand rather than shipped with every row.
        document.getElementById('results-tbody').addEventListener('click', async function (e) {
            const btn = e.target.closest('button[data-log-url]');
            if (!btn) return;

            const row = btn.closest('tr');
            const existing = row.nextElementSibling;
            if (existing && existing.classList.contains('smtp-log-row')) {
                existing.classList.toggle('d-none');
                return;
            }

            btn.disabled = true;
            try {
                const resp = await fetch(btn.dataset.logUrl);
                const text = resp.ok ? await resp.text() : 'Failed to load log (' + resp.status + ')';
                const logRow = document.createElement('tr');
                logRow.className = 'smtp-log-row';
                logRow.innerHTML = '<td colspan="9"><pre class="bg-dark text-light p-3 rounded small mb-0">' + escHtml(text) + '</pre></td>';
                row.after(logRow);
            } finally {
                btn.disabled = false;
            }
        });

        if (!@(isLive ? "true" : "false")) return;

        const POLL_INTERVAL_MS = 2000;
        const jobId = @Model.Job.Id;
        const total = @Model.Job.TotalEmails;
        let cursor = 0;

        function badge(yes) {
            return yes
                ? '<span class="badge bg-success">✓ Yes</span>'
                : '<span class="badge bg-danger">✗ No</span>';
        }

        function mailboxBadge(r) {
            if (r.pendingRetest) {
                return '<span class="badge bg-secondary">… Pending</span>';
            }
            if (r.isRetryable) {
                return '<span class="badge bg-warning text-dark">? Unknown</span>';
            }
            return badge(r.mailboxExists);
        }

        function statusBadge(r) {
            if (r.pendingRetest) {
                return '<span class="badge bg-info">🔄 Retesting</span>';
            }
            if (r.isPotentialSoftFailure) {
                return '<span class="badge bg-warning text-dark">⚠ At risk (list match)</span>';
            }
            if (r.isAtRisk) {
                return '<span class="badge bg-warning text-dark">⚠ At risk' + (r.isCatchAll ? ' (catch-all)' : '') + '</span>';
            }
            if (r.isVerified) {
                return '<span class="badge bg-success">✓ Verified</span>';
            }
            if (r.isRetryable) {
                return '<span class="badge bg-warning text-dark">⟳ Retryable</span>';
            }
            if (r.domainExists && r.hasMxRecords && !r.mailboxExists && !r.errorMessage) {
                return '<span class="badge bg-danger">✗ Invalid Mailbox</span>';
            }
            if (r.errorMessage) {
                return '<span class="badge bg-danger">⚠ Failed</span>';
            }
            return '<span class="badge bg-secondary">• Unverified</span>';
        }

        function rowHtml(r) {
            const softFailure = r.isPotentialSoftFailure
                ? '<span class="badge bg-warning text-dark">Match</span>' + (r.softFailureNote ? '<div class="small text-muted mt-1">' + escHtml(r.softFailureNote) + '</div>' : '')
                : '<span class="text-muted small">—</span>';
            const logButton = r.hasLog
                ? '<button class="btn btn-sm btn-outline-secondary" type="button" data-log-url="/api/jobs/' + jobId + '/results/' + r.id + '/log">Show Log</button>'
                : '';
            return `
                <td>${escHtml(r.emailAddress)}</td>
                <td>${badge(r.domainExists)}</td>
                <td>${badge(r.hasMxRecords)}</td>
                <td>${mailboxBadge(r)}</td>
                <td>${statusBadge(r)}</td>
                <td>${softFailure}</td>
                <td>${r.errorMessage ? '<span class="text-danger small">' + escHtml(r.errorMessage) + '</span>' : ''}</td>
                <td class="small">${escHtml(r.verifiedAt)}</td>
                <td>${logButton}</td>`;
        }

        function upsertResult(r) {
            const tbody = document.getElementById('results-tbody');
            let tr = tbody.querySelector('tr[data-result-id="' + r.id + '"]');
            if (tr) {
                // Result was re-verified: drop its stale log and redraw the row.
                const next = tr.nextElementSibling;
                if (next && next.classList.contains('smtp-log-row')) next.remove();
            } else {
                tr = document.createElement('tr');
                tr.dataset.resultId = r.id;
                tbody.appendChild(tr);
            }
            tr.innerHTML = rowHtml(r);
        }

        function formatTimeRemaining(seconds) {
            if (seconds <= 0) return '—';
            if (seconds >= 3600) {
                return Math.floor(seconds / 3600) + 'h ' + Math.floor((seconds % 3600) / 60) + 'm';
            }
            if (seconds >= 60) {
                return Math.floor(seconds / 60) + 'm ' + Math.floor(seconds % 60) + 's';
            }
            return Math.floor(seconds) + 's';
        }

        function updateProgress(processed, status, createdAtUtc) {
            const pct = total > 0 ? Math.round(processed * 100 / total) : 0;
            document.getElementById('progress-bar').style.width = pct + '%';
            document.getElementById('progress-label').textContent = processed + ' / ' + total;

            const badgeEl = document.getElementById('status-badge');
            badgeEl.textContent = status;
            badgeEl.className = 'badge fs-6 ' + ({
                Completed: 'bg-success',
                Processing: 'bg-warning text-dark',
                Pending: 'bg-secondary',
                Failed: 'bg-danger',
                Stopped: 'bg-secondary'
            }[status] ?? 'bg-secondary');

            if (status !== 'Pending' && status !== 'Processing') {
                const bar = document.getElementById('progress-bar');
                bar.classList.remove('progress-bar-striped', 'progress-bar-animated');
                bar.classList.add(status === 'Completed' ? 'bg-success' : 'bg-danger');
            }

            if ((status === 'Pending' || status === 'Processing') && processed > 0 && createdAtUtc) {
                const elapsedSeconds = (Date.now() - createdAtUtc) / 1000;
                const estimate = (elapsedSeconds / processed) * (total - processed);
                const etaDisplay = document.getElementById('eta-display');
                if (etaDisplay) etaDisplay.textContent = formatTimeRemaining(estimate);
            }
        }

        let pollTimer = null;
        async function poll() {
            try {
                const resp = await fetch('/api/jobs/' + jobId + '/progress?since=' + cursor);
                if (!resp.ok) return;
                const data = await resp.json();

                updateProgress(data.processedEmails, data.status, data.createdAtUtc);
                (data.results ?? []).forEach(upsertResult);
                cursor = data.cursor || cursor;
                document.getElementById('valid-count').textContent = data.validCount;

                if (data.status !== 'Pending' && data.status !== 'Processing') {
                    clearInterval(pollTimer);
                }
            } catch (e) {
                // network hiccup — keep retrying
            }
        }

        pollTimer = setInterval(poll, POLL_INTERVAL_MS);
        poll(); // immediate first fetch
    })();
    </script>
}
