# Copy to .env and fill in. docker compose refuses to start without the required values.

# Required
POSTGRES_PASSWORD=
OIDC_CLIENT_SECRET=

# Optional (defaults shown)
# POSTGRES_DB=mailverifier
# POSTGRES_USER=mailverifier
# OIDC_AUTHORITY=https://auth.neillans.co.uk/realms/MailCheck
# OIDC_CLIENT_ID=mail-verifier
# OIDC_CALLBACK_PATH=/signin-oidc
# OIDC_SIGNED_OUT_CALLBACK_PATH=/signout-callback-oidc
# OIDC_CALLBACK_SCHEME=http
# OIDC_CALLBACK_HOST=localhost:8080
# SMTP_EHLO_HOST=mailverifier.local
